# --- Pinecone (vector DB + hosted embedding/rerank inference) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=lexi-legal-precedents-v1
PINECONE_NAMESPACE=corpus-v1

# --- LLM provider: Google Gemini ---
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.5-flash

# --- LangSmith (observability + evaluation) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lexi-legal-research
LANGSMITH_TRACING=true

# --- App ---
APP_ENV=development
CORPUS_VERSION=corpus-v1
